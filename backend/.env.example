# You only need ONE key: OpenAI OR Gemini. If the preferred provider below has
# no key, the server automatically uses the other one.

# Preferred provider for embeddings: "openai" or "gemini".
# Changing it later means existing items must be re-ingested (vectors from
# different models are not comparable).
EMBEDDING_PROVIDER=openai

# Preferred provider for answering questions: "openai" or "gemini".
# If both keys are set, the UI shows a switch to pick one per question.
CHAT_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

DATABASE_PATH=data/inbox.db
LOG_LEVEL=INFO
